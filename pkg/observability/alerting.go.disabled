package observability

import (
	"context"
	"encoding/json"
	"fmt"
	"time"

	"github.com/prometheus/alertmanager/api/v2/client"
	"github.com/prometheus/alertmanager/api/v2/models"
	"go.uber.org/zap"
)

// AlertManager manages alert rules and notifications
type AlertManager struct {
	client     *client.Alertmanager
	rules      map[string]*AlertRule
	channels   map[string]AlertChannel
	logger     *zap.Logger
	config     *AlertConfig
}

// AlertConfig contains alerting configuration
type AlertConfig struct {
	AlertmanagerURL string            `yaml:"alertmanager_url"`
	DefaultChannel  string            `yaml:"default_channel"`
	Rules           []*AlertRule      `yaml:"rules"`
	Channels        []AlertChannel    `yaml:"channels"`
	EvaluationInterval time.Duration  `yaml:"evaluation_interval"`
}

// AlertRule defines an alert condition
type AlertRule struct {
	Name        string                 `yaml:"name"`
	Expression  string                 `yaml:"expression"`
	Duration    time.Duration          `yaml:"duration"`
	Severity    AlertSeverity          `yaml:"severity"`
	Labels      map[string]string      `yaml:"labels"`
	Annotations map[string]string      `yaml:"annotations"`
	Channels    []string               `yaml:"channels"`
	Active      bool                   `yaml:"active"`
	LastEval    time.Time
	LastFired   *time.Time
}

// AlertSeverity represents the severity of an alert
type AlertSeverity string

const (
	SeverityCritical AlertSeverity = "critical"
	SeverityWarning  AlertSeverity = "warning"
	SeverityInfo     AlertSeverity = "info"
)

// AlertChannel represents a notification channel
type AlertChannel interface {
	Send(alert *Alert) error
	GetName() string
	IsEnabled() bool
}

// Alert represents an active alert
type Alert struct {
	ID          string            `json:"id"`
	Rule        string            `json:"rule"`
	Severity    AlertSeverity    `json:"severity"`
	Labels      map[string]string `json:"labels"`
	Annotations map[string]string `json:"annotations"`
	StartsAt    time.Time         `json:"starts_at"`
	EndsAt      *time.Time        `json:"ends_at,omitempty"`
	Status      AlertStatus       `json:"status"`
	Value       float64           `json:"value"`
}

// AlertStatus represents the status of an alert
type AlertStatus string

const (
	AlertStatusFiring   AlertStatus = "firing"
	AlertStatusResolved AlertStatus = "resolved"
	AlertStatusPending  AlertStatus = "pending"
)

// NewAlertManager creates a new alert manager
func NewAlertManager(config *AlertConfig, logger *zap.Logger) (*AlertManager, error) {
	// Initialize Alertmanager client if URL provided
	var amClient *client.Alertmanager
	if config.AlertmanagerURL != "" {
		cfg := client.DefaultTransportConfig().WithHost(config.AlertmanagerURL)
		amClient = client.NewHTTPClientWithConfig(nil, cfg)
	}

	am := &AlertManager{
		client:   amClient,
		rules:    make(map[string]*AlertRule),
		channels: make(map[string]AlertChannel),
		logger:   logger,
		config:   config,
	}

	// Register alert rules
	for _, rule := range config.Rules {
		am.RegisterRule(rule)
	}

	// Start evaluation loop
	go am.evaluateLoop()

	return am, nil
}

// RegisterRule registers an alert rule
func (am *AlertManager) RegisterRule(rule *AlertRule) {
	am.rules[rule.Name] = rule
	am.logger.Info("Alert rule registered",
		zap.String("rule", rule.Name),
		zap.String("severity", string(rule.Severity)))
}

// RegisterChannel registers an alert channel
func (am *AlertManager) RegisterChannel(channel AlertChannel) {
	am.channels[channel.GetName()] = channel
	am.logger.Info("Alert channel registered",
		zap.String("channel", channel.GetName()))
}

// evaluateLoop continuously evaluates alert rules
func (am *AlertManager) evaluateLoop() {
	ticker := time.NewTicker(am.config.EvaluationInterval)
	defer ticker.Stop()

	for range ticker.C {
		am.evaluateRules()
	}
}

// evaluateRules evaluates all active alert rules
func (am *AlertManager) evaluateRules() {
	for _, rule := range am.rules {
		if !rule.Active {
			continue
		}

		// Evaluate rule expression
		if am.shouldFire(rule) {
			am.fireAlert(rule)
		} else if rule.LastFired != nil {
			am.resolveAlert(rule)
		}

		rule.LastEval = time.Now()
	}
}

// shouldFire checks if an alert should fire
func (am *AlertManager) shouldFire(rule *AlertRule) bool {
	// This would typically evaluate the Prometheus expression
	// For now, returning false as placeholder
	return false
}

// fireAlert fires an alert
func (am *AlertManager) fireAlert(rule *AlertRule) {
	alert := &Alert{
		ID:          fmt.Sprintf("%s-%d", rule.Name, time.Now().Unix()),
		Rule:        rule.Name,
		Severity:    rule.Severity,
		Labels:      rule.Labels,
		Annotations: rule.Annotations,
		StartsAt:    time.Now(),
		Status:      AlertStatusFiring,
	}

	// Send to Alertmanager if configured
	if am.client != nil {
		am.sendToAlertmanager(alert)
	}

	// Send to configured channels
	for _, channelName := range rule.Channels {
		if channel, exists := am.channels[channelName]; exists && channel.IsEnabled() {
			if err := channel.Send(alert); err != nil {
				am.logger.Error("Failed to send alert",
					zap.String("channel", channelName),
					zap.Error(err))
			}
		}
	}

	now := time.Now()
	rule.LastFired = &now

	am.logger.Warn("Alert fired",
		zap.String("rule", rule.Name),
		zap.String("severity", string(rule.Severity)))
}

// resolveAlert resolves an active alert
func (am *AlertManager) resolveAlert(rule *AlertRule) {
	alert := &Alert{
		ID:       fmt.Sprintf("%s-%d", rule.Name, time.Now().Unix()),
		Rule:     rule.Name,
		Severity: rule.Severity,
		Status:   AlertStatusResolved,
		EndsAt:   &time.Time{},
	}

	*alert.EndsAt = time.Now()

	// Notify channels
	for _, channelName := range rule.Channels {
		if channel, exists := am.channels[channelName]; exists && channel.IsEnabled() {
			channel.Send(alert)
		}
	}

	rule.LastFired = nil

	am.logger.Info("Alert resolved",
		zap.String("rule", rule.Name))
}

// sendToAlertmanager sends alert to Prometheus Alertmanager
func (am *AlertManager) sendToAlertmanager(alert *Alert) {
	// Convert to Alertmanager format
	amAlert := &models.PostableAlert{
		Alert: models.Alert{
			Labels: alert.Labels,
		},
		Annotations: alert.Annotations,
		StartsAt:    alert.StartsAt,
		EndsAt:      alert.EndsAt,
	}

	// Send to Alertmanager
	// Implementation would use am.client to post alert
	_ = amAlert
}

// SlackChannel sends alerts to Slack
type SlackChannel struct {
	WebhookURL string
	Channel    string
	Username   string
	Enabled    bool
}

func (s *SlackChannel) Send(alert *Alert) error {
	// Slack webhook implementation
	payload := map[string]interface{}{
		"channel":  s.Channel,
		"username": s.Username,
		"text":     fmt.Sprintf("🚨 Alert: %s", alert.Rule),
		"attachments": []map[string]interface{}{
			{
				"color": getColorForSeverity(alert.Severity),
				"fields": []map[string]interface{}{
					{"title": "Severity", "value": alert.Severity, "short": true},
					{"title": "Status", "value": alert.Status, "short": true},
					{"title": "Time", "value": alert.StartsAt.Format(time.RFC3339), "short": false},
				},
			},
		},
	}

	// Send to Slack webhook
	_ = payload
	return nil
}

func (s *SlackChannel) GetName() string { return "slack" }
func (s *SlackChannel) IsEnabled() bool { return s.Enabled }

// EmailChannel sends alerts via email
type EmailChannel struct {
	SMTPHost   string
	SMTPPort   int
	Username   string
	Password   string
	From       string
	To         []string
	Enabled    bool
}

func (e *EmailChannel) Send(alert *Alert) error {
	// Email implementation
	subject := fmt.Sprintf("[%s] Alert: %s", alert.Severity, alert.Rule)
	body := fmt.Sprintf(`
Alert: %s
Severity: %s
Status: %s
Time: %s

Labels: %v
Annotations: %v
`,
		alert.Rule,
		alert.Severity,
		alert.Status,
		alert.StartsAt.Format(time.RFC3339),
		alert.Labels,
		alert.Annotations,
	)

	// Send email
	_ = subject
	_ = body
	return nil
}

func (e *EmailChannel) GetName() string { return "email" }
func (e *EmailChannel) IsEnabled() bool { return e.Enabled }

// PagerDutyChannel sends alerts to PagerDuty
type PagerDutyChannel struct {
	ServiceKey string
	Enabled    bool
}

func (p *PagerDutyChannel) Send(alert *Alert) error {
	// PagerDuty implementation
	event := map[string]interface{}{
		"service_key":  p.ServiceKey,
		"incident_key": alert.ID,
		"event_type":   getEventType(alert.Status),
		"description":  fmt.Sprintf("%s: %s", alert.Severity, alert.Rule),
		"details":      alert,
	}

	// Send to PagerDuty
	_ = event
	return nil
}

func (p *PagerDutyChannel) GetName() string { return "pagerduty" }
func (p *PagerDutyChannel) IsEnabled() bool { return p.Enabled }

// WebhookChannel sends alerts to a generic webhook
type WebhookChannel struct {
	URL     string
	Headers map[string]string
	Enabled bool
}

func (w *WebhookChannel) Send(alert *Alert) error {
	// Marshal alert to JSON
	data, err := json.Marshal(alert)
	if err != nil {
		return err
	}

	// Send to webhook
	_ = data
	return nil
}

func (w *WebhookChannel) GetName() string { return "webhook" }
func (w *WebhookChannel) IsEnabled() bool { return w.Enabled }

// Helper functions

func getColorForSeverity(severity AlertSeverity) string {
	switch severity {
	case SeverityCritical:
		return "#FF0000"
	case SeverityWarning:
		return "#FFA500"
	case SeverityInfo:
		return "#0000FF"
	default:
		return "#808080"
	}
}

func getEventType(status AlertStatus) string {
	switch status {
	case AlertStatusFiring:
		return "trigger"
	case AlertStatusResolved:
		return "resolve"
	default:
		return "acknowledge"
	}
}

