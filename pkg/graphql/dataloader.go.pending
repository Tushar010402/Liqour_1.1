func (dl *DataLoaders) stockBatchFunc(ctx context.Context, keys []ProductShopKey) []*dataloader.Result[*models.Stock] {
	results := make([]*dataloader.Result[*models.Stock], len(keys))

	// Build query conditions
	var conditions []string
	var args []interface{}
	for _, key := range keys {
		conditions = append(conditions, "(product_id = ? AND shop_id = ?)")
		args = append(args, key.ProductID, key.ShopID)
	}

	query := "(" + conditions[0]
	for i := 1; i < len(conditions); i++ {
		query += " OR " + conditions[i]
	}
	query += ")"

	var stocks []models.Stock
	if err := dl.db.WithContext(ctx).Where(query, args...).Find(&stocks).Error; err != nil {
		for i := range results {
			results[i] = &dataloader.Result[*models.Stock]{Error: err}
		}
		return results
	}

	// Create map with composite key
	stockMap := make(map[string]*models.Stock)
	for i := range stocks {
		key := fmt.Sprintf("%s:%s", stocks[i].ProductID, stocks[i].ShopID)
		stockMap[key] = &stocks[i]
	}

	for i, key := range keys {
		if stock, ok := stockMap[key.String()]; ok {
			results[i] = &dataloader.Result[*models.Stock]{Data: stock}
		} else {
			results[i] = &dataloader.Result[*models.Stock]{
				Data: &models.Stock{
					ProductID: key.ProductID,
					ShopID:    key.ShopID,
					Quantity:  0,
				},
			}
		}
	}

	return results
}

// Batch functions for collections

func (dl *DataLoaders) productsByBrandBatchFunc(ctx context.Context, brandIDs []string) []*dataloader.Result[[]*models.Product] {
	results := make([]*dataloader.Result[[]*models.Product], len(brandIDs))

	var products []models.Product
	if err := dl.db.WithContext(ctx).Where("brand_id IN ?", brandIDs).Find(&products).Error; err != nil {
		for i := range results {
			results[i] = &dataloader.Result[[]*models.Product]{Error: err}
		}
		return results
	}

	// Group products by brand
	productsByBrand := make(map[string][]*models.Product)
	for i := range products {
		brandID := products[i].BrandID
		productsByBrand[brandID] = append(productsByBrand[brandID], &products[i])
	}

	for i, brandID := range brandIDs {
		if prods, ok := productsByBrand[brandID]; ok {
			results[i] = &dataloader.Result[[]*models.Product]{Data: prods}
		} else {
			results[i] = &dataloader.Result[[]*models.Product]{Data: []*models.Product{}}
		}
	}

	return results
}

func (dl *DataLoaders) productsByCategoryBatchFunc(ctx context.Context, categoryIDs []string) []*dataloader.Result[[]*models.Product] {
	results := make([]*dataloader.Result[[]*models.Product], len(categoryIDs))

	var products []models.Product
	if err := dl.db.WithContext(ctx).Where("category_id IN ?", categoryIDs).Find(&products).Error; err != nil {
		for i := range results {
			results[i] = &dataloader.Result[[]*models.Product]{Error: err}
		}
		return results
	}

	productsByCategory := make(map[string][]*models.Product)
	for i := range products {
		categoryID := products[i].CategoryID
		productsByCategory[categoryID] = append(productsByCategory[categoryID], &products[i])
	}

	for i, categoryID := range categoryIDs {
		if prods, ok := productsByCategory[categoryID]; ok {
			results[i] = &dataloader.Result[[]*models.Product]{Data: prods}
		} else {
			results[i] = &dataloader.Result[[]*models.Product]{Data: []*models.Product{}}
		}
	}

	return results
}

func (dl *DataLoaders) stocksByShopBatchFunc(ctx context.Context, shopIDs []string) []*dataloader.Result[[]*models.Stock] {
	results := make([]*dataloader.Result[[]*models.Stock], len(shopIDs))

	var stocks []models.Stock
	if err := dl.db.WithContext(ctx).
		Preload("Product").
		Where("shop_id IN ?", shopIDs).
		Find(&stocks).Error; err != nil {
		for i := range results {
			results[i] = &dataloader.Result[[]*models.Stock]{Error: err}
		}
		return results
	}

	stocksByShop := make(map[string][]*models.Stock)
	for i := range stocks {
		shopID := stocks[i].ShopID
		stocksByShop[shopID] = append(stocksByShop[shopID], &stocks[i])
	}

	for i, shopID := range shopIDs {
		if stks, ok := stocksByShop[shopID]; ok {
			results[i] = &dataloader.Result[[]*models.Stock]{Data: stks}
		} else {
			results[i] = &dataloader.Result[[]*models.Stock]{Data: []*models.Stock{}}
		}
	}

	return results
}

func (dl *DataLoaders) usersByShopBatchFunc(ctx context.Context, shopIDs []string) []*dataloader.Result[[]*models.User] {
	results := make([]*dataloader.Result[[]*models.User], len(shopIDs))

	// Query users with their shop associations
	var shopUsers []struct {
		ShopID string
		UserID string
	}

	if err := dl.db.WithContext(ctx).
		Table("user_shops").
		Where("shop_id IN ?", shopIDs).
		Find(&shopUsers).Error; err != nil {
		for i := range results {
			results[i] = &dataloader.Result[[]*models.User]{Error: err}
		}
		return results
	}

	// Get unique user IDs
	userIDSet := make(map[string]bool)
	for _, su := range shopUsers {
		userIDSet[su.UserID] = true
	}

	userIDs := make([]string, 0, len(userIDSet))
	for id := range userIDSet {
		userIDs = append(userIDs, id)
	}

	// Fetch all users
	var users []models.User
	if len(userIDs) > 0 {
		if err := dl.db.WithContext(ctx).Where("id IN ?", userIDs).Find(&users).Error; err != nil {
			for i := range results {
				results[i] = &dataloader.Result[[]*models.User]{Error: err}
			}
			return results
		}
	}

	// Create user map
	userMap := make(map[string]*models.User)
	for i := range users {
		userMap[users[i].ID] = &users[i]
	}

	// Group users by shop
	usersByShop := make(map[string][]*models.User)
	for _, su := range shopUsers {
		if user, ok := userMap[su.UserID]; ok {
			usersByShop[su.ShopID] = append(usersByShop[su.ShopID], user)
		}
	}

	for i, shopID := range shopIDs {
		if usrs, ok := usersByShop[shopID]; ok {
			results[i] = &dataloader.Result[[]*models.User]{Data: usrs}
		} else {
			results[i] = &dataloader.Result[[]*models.User]{Data: []*models.User{}}
		}
	}

	return results
}

func (dl *DataLoaders) salesByShopBatchFunc(ctx context.Context, shopIDs []string) []*dataloader.Result[[]*models.Sale] {
	results := make([]*dataloader.Result[[]*models.Sale], len(shopIDs))

	// Query last 100 sales per shop
	var sales []models.Sale
	if err := dl.db.WithContext(ctx).
		Preload("SaleItems").
		Where("shop_id IN ?", shopIDs).
		Order("created_at DESC").
		Limit(100 * len(shopIDs)).
		Find(&sales).Error; err != nil {
		for i := range results {
			results[i] = &dataloader.Result[[]*models.Sale]{Error: err}
		}
		return results
	}

	salesByShop := make(map[string][]*models.Sale)
	for i := range sales {
		shopID := sales[i].ShopID
		if len(salesByShop[shopID]) < 100 {
			salesByShop[shopID] = append(salesByShop[shopID], &sales[i])
		}
	}

	for i, shopID := range shopIDs {
		if sls, ok := salesByShop[shopID]; ok {
			results[i] = &dataloader.Result[[]*models.Sale]{Data: sls}
		} else {
			results[i] = &dataloader.Result[[]*models.Sale]{Data: []*models.Sale{}}
		}
	}

	return results
}

// Context helpers

type loaderKey struct{}

// WithLoaders returns a context with data loaders attached
func WithLoaders(ctx context.Context, loaders *DataLoaders) context.Context {
	return context.WithValue(ctx, loaderKey{}, loaders)
}

// GetLoaders retrieves data loaders from context
func GetLoaders(ctx context.Context) *DataLoaders {
	if loaders, ok := ctx.Value(loaderKey{}).(*DataLoaders); ok {
		return loaders
	}
	return nil
}

// LoaderMiddleware creates middleware that attaches data loaders to the context
func LoaderMiddleware(db *gorm.DB, logger *zap.Logger) func(context.Context) context.Context {
	return func(ctx context.Context) context.Context {
		loaders := NewDataLoaders(db, logger)
		return WithLoaders(ctx, loaders)
	}
}