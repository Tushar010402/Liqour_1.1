package graphql

import (
	"context"
	"fmt"
	"sync"
	"time"

	"github.com/graph-gophers/dataloader/v7"
	"github.com/liquorpro/go-backend/pkg/shared/models"
	"go.uber.org/zap"
	"gorm.io/gorm"
)

// DataLoaders contains all the data loaders for efficient batching
type DataLoaders struct {
	ProductByID      *dataloader.Loader[string, *models.Product]
	BrandByID        *dataloader.Loader[string, *models.Brand]
	CategoryByID     *dataloader.Loader[string, *models.Category]
	SubcategoryByID  *dataloader.Loader[string, *models.Subcategory]
	UserByID         *dataloader.Loader[string, *models.User]
	ShopByID         *dataloader.Loader[string, *models.Shop]
	CustomerByID     *dataloader.Loader[string, *models.Customer]
	StockByProductID *dataloader.Loader[ProductShopKey, *models.Stock]
	SalesByShopID    *dataloader.Loader[string, []*models.Sale]

	// Batch loaders for related entities
	ProductsByBrandID    *dataloader.Loader[string, []*models.Product]
	ProductsByCategoryID *dataloader.Loader[string, []*models.Product]
	StocksByShopID       *dataloader.Loader[string, []*models.Stock]
	UsersByShopID        *dataloader.Loader[string, []*models.User]

	db     *gorm.DB
	logger *zap.Logger
	cache  *LoaderCache
}

// ProductShopKey is a composite key for product-shop combinations
type ProductShopKey struct {
	ProductID string
	ShopID    string
}

func (k ProductShopKey) String() string {
	return fmt.Sprintf("%s:%s", k.ProductID, k.ShopID)
}

// LoaderCache provides caching for data loaders
type LoaderCache struct {
	data map[string]interface{}
	ttl  map[string]time.Time
	mu   sync.RWMutex
}

func NewLoaderCache() *LoaderCache {
	return &LoaderCache{
		data: make(map[string]interface{}),
		ttl:  make(map[string]time.Time),
	}
}

func (c *LoaderCache) Get(key string) (interface{}, bool) {
	c.mu.RLock()
	defer c.mu.RUnlock()

	if expiry, exists := c.ttl[key]; exists {
		if time.Now().After(expiry) {
			return nil, false
		}
		if val, ok := c.data[key]; ok {
			return val, true
		}
	}
	return nil, false
}

func (c *LoaderCache) Set(key string, value interface{}, ttl time.Duration) {
	c.mu.Lock()
	defer c.mu.Unlock()

	c.data[key] = value
	c.ttl[key] = time.Now().Add(ttl)
}

// NewDataLoaders creates new data loaders with batching and caching
func NewDataLoaders(db *gorm.DB, logger *zap.Logger) *DataLoaders {
	loaders := &DataLoaders{
		db:     db,
		logger: logger,
		cache:  NewLoaderCache(),
	}

	// Initialize individual entity loaders
	loaders.ProductByID = dataloader.NewBatchedLoader(
		loaders.productBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, *models.Product]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(100),
	)

	loaders.BrandByID = dataloader.NewBatchedLoader(
		loaders.brandBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, *models.Brand]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(50),
	)

	loaders.CategoryByID = dataloader.NewBatchedLoader(
		loaders.categoryBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, *models.Category]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(50),
	)

	loaders.SubcategoryByID = dataloader.NewBatchedLoader(
		loaders.subcategoryBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, *models.Subcategory]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(50),
	)

	loaders.UserByID = dataloader.NewBatchedLoader(
		loaders.userBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, *models.User]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(100),
	)

	loaders.ShopByID = dataloader.NewBatchedLoader(
		loaders.shopBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, *models.Shop]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(50),
	)

	loaders.CustomerByID = dataloader.NewBatchedLoader(
		loaders.customerBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, *models.Customer]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(100),
	)

	loaders.StockByProductID = dataloader.NewBatchedLoader(
		loaders.stockBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[ProductShopKey, *models.Stock]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(100),
	)

	// Initialize collection loaders
	loaders.ProductsByBrandID = dataloader.NewBatchedLoader(
		loaders.productsByBrandBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, []*models.Product]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(50),
	)

	loaders.ProductsByCategoryID = dataloader.NewBatchedLoader(
		loaders.productsByCategoryBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, []*models.Product]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(50),
	)

	loaders.StocksByShopID = dataloader.NewBatchedLoader(
		loaders.stocksByShopBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, []*models.Stock]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(50),
	)

	loaders.UsersByShopID = dataloader.NewBatchedLoader(
		loaders.usersByShopBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, []*models.User]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(50),
	)

	loaders.SalesByShopID = dataloader.NewBatchedLoader(
		loaders.salesByShopBatchFunc,
		dataloader.WithCache(&dataloader.InMemoryCache[string, []*models.Sale]{}),
		dataloader.WithWait(10*time.Millisecond),
		dataloader.WithBatch(50),
	)

	return loaders
}

// Batch functions for individual entities

func (dl *DataLoaders) productBatchFunc(ctx context.Context, keys []string) []*dataloader.Result[*models.Product] {
	results := make([]*dataloader.Result[*models.Product], len(keys))

	// Query all products in one batch
	var products []models.Product
	if err := dl.db.WithContext(ctx).Where("id IN ?", keys).Find(&products).Error; err != nil {
		for i := range results {
			results[i] = &dataloader.Result[*models.Product]{Error: err}
		}
		return results
	}

	// Create map for O(1) lookup
	productMap := make(map[string]*models.Product)
	for i := range products {
		productMap[products[i].ID] = &products[i]
	}

	// Build results maintaining order
	for i, key := range keys {
		if product, ok := productMap[key]; ok {
			results[i] = &dataloader.Result[*models.Product]{Data: product}
			// Cache the result
			dl.cache.Set(fmt.Sprintf("product:%s", key), product, 5*time.Minute)
		} else {
			results[i] = &dataloader.Result[*models.Product]{Error: fmt.Errorf("product not found: %s", key)}
		}
	}

	dl.logger.Debug("Batch loaded products",
		zap.Int("requested", len(keys)),
		zap.Int("found", len(products)))

	return results
}

func (dl *DataLoaders) brandBatchFunc(ctx context.Context, keys []string) []*dataloader.Result[*models.Brand] {
	results := make([]*dataloader.Result[*models.Brand], len(keys))

	var brands []models.Brand
	if err := dl.db.WithContext(ctx).Where("id IN ?", keys).Find(&brands).Error; err != nil {
		for i := range results {
			results[i] = &dataloader.Result[*models.Brand]{Error: err}
		}
		return results
	}

	brandMap := make(map[string]*models.Brand)
	for i := range brands {
		brandMap[brands[i].ID] = &brands[i]
	}

	for i, key := range keys {
		if brand, ok := brandMap[key]; ok {
			results[i] = &dataloader.Result[*models.Brand]{Data: brand}
			dl.cache.Set(fmt.Sprintf("brand:%s", key), brand, 10*time.Minute)
		} else {
			results[i] = &dataloader.Result[*models.Brand]{Error: fmt.Errorf("brand not found: %s", key)}
		}
	}

	return results
}

