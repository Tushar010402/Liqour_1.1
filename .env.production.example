# ============================================================================
# LiquorPro Production Environment Configuration
# ============================================================================
# Copy this file to .env.production and update with your actual values
# NEVER commit .env.production to version control
# ============================================================================

# ============================================================================
# DEPLOYMENT METADATA
# ============================================================================
VERSION=1.0.0
BUILD_DATE=2025-10-27
GIT_COMMIT=latest
APP_ENVIRONMENT=production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=liquorpro
DATABASE_USER=liquorpro

# CRITICAL: Change this password in production!
# Use a strong password with at least 32 characters
DATABASE_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_32_CHARS_MINIMUM

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# CRITICAL: Change this password in production!
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_32_CHARS_MINIMUM

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# CRITICAL: Generate a random secret with at least 32 characters
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_JWT_SECRET_USE_OPENSSL_RAND_BASE64_32

# ============================================================================
# SERVICE PORTS (only change if you have port conflicts)
# ============================================================================
GATEWAY_PORT=8090
AUTH_PORT=8091
SALES_PORT=8092
INVENTORY_PORT=8093
FINANCE_PORT=8094
SAAS_PORT=8095
POSTGRES_PORT=5432
REDIS_PORT=6379

# ============================================================================
# KAFKA CONFIGURATION (Optional - for event streaming)
# ============================================================================
KAFKA_ENABLED=false
KAFKA_BROKERS=

# If enabling Kafka, set to true and provide broker addresses:
# KAFKA_ENABLED=true
# KAFKA_BROKERS=kafka1:9092,kafka2:9092,kafka3:9092

# ============================================================================
# OCR API CONFIGURATION (for Sales Service)
# ============================================================================
# Google Vision API - Place credentials in ./credentials/google-vision-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/google-vision-credentials.json

# Gemini API Key (optional)
GEMINI_API_KEY=

# ============================================================================
# MONITORING & OBSERVABILITY (Optional)
# ============================================================================
ENABLE_METRICS=true
ENABLE_TRACING=false
JAEGER_ENDPOINT=

# ============================================================================
# BACKUP CONFIGURATION (Optional)
# ============================================================================
BACKUP_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================================
# SSL/TLS CONFIGURATION (for production deployment)
# ============================================================================
# Enable when using HTTPS with reverse proxy (nginx, traefik, etc.)
ENABLE_TLS=false
TLS_CERT_PATH=/certs/server.crt
TLS_KEY_PATH=/certs/server.key

# ============================================================================
# DEPLOYMENT TARGET
# ============================================================================
# Production server IP or domain
PRODUCTION_SERVER=72.60.96.174
PRODUCTION_USER=root

# ============================================================================
# PERFORMANCE TUNING
# ============================================================================
# Database connection pool (adjust based on load)
DB_MAX_OPEN_CONNS=200
DB_MAX_IDLE_CONNS=50

# Redis cache settings
REDIS_MAX_MEMORY=2gb
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. Always use HTTPS in production
# 2. Use strong passwords (minimum 32 characters)
# 3. Enable firewall and restrict access to database ports
# 4. Regularly rotate JWT secrets and database passwords
# 5. Never expose Redis or PostgreSQL ports to public internet
# 6. Use read-only file systems where possible
# 7. Enable Docker security features (no-new-privileges, read-only)
# ============================================================================
