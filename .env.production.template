# LiquorPro SaaS Production Environment Configuration
# Copy this file to .env.production and update values for your production environment

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_ENVIRONMENT=production
APP_DEBUG=false
APP_LOG_LEVEL=info

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Production PostgreSQL Database
DATABASE_HOST=your-production-db-host.com
DATABASE_PORT=5432
DATABASE_USER=liquorpro_prod
DATABASE_PASSWORD=your-super-secure-db-password
DATABASE_NAME=liquorpro_production
DATABASE_SSL_MODE=require
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=1h

# Database connection string format (alternative to individual settings)
# DATABASE_URL=postgres://username:password@host:port/dbname?sslmode=require

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Production Redis Cache
REDIS_HOST=your-production-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=your-super-secure-redis-password
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=20
REDIS_POOL_TIMEOUT=30s

# Redis connection string format (alternative to individual settings)
# REDIS_URL=redis://:password@host:port/db

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# CRITICAL: Generate a secure JWT secret for production!
# Use: openssl rand -base64 64
JWT_SECRET=your-production-jwt-secret-minimum-64-characters-long-please-change-this
JWT_ACCESS_TOKEN_EXPIRY=24h
JWT_REFRESH_TOKEN_EXPIRY=30d
JWT_ISSUER=liquorpro-saas
JWT_AUDIENCE=liquorpro-tenants

# =============================================================================
# PAYMENT GATEWAY (RAZORPAY)
# =============================================================================
RAZORPAY_KEY_ID=your_production_razorpay_key_id
RAZORPAY_KEY_SECRET=your_production_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_production_webhook_secret

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=LiquorPro SaaS

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com,https://app.yourdomain.com

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Session settings
SESSION_SECRET=your-production-session-secret-change-this
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================
# Enable HTTPS
ENABLE_HTTPS=true
SSL_CERT_PATH=/path/to/your/ssl/certificate.crt
SSL_KEY_PATH=/path/to/your/ssl/private.key

# Let's Encrypt (if using automatic SSL)
LETSENCRYPT_ENABLED=true
LETSENCRYPT_EMAIL=admin@yourdomain.com
LETSENCRYPT_DOMAINS=yourdomain.com,api.yourdomain.com

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
# Application Performance Monitoring
APM_ENABLED=true
APM_SERVICE_NAME=liquorpro-saas
APM_SERVICE_VERSION=1.0.0

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/liquorpro/saas.log
LOG_MAX_SIZE=100MB
LOG_MAX_BACKUPS=7
LOG_MAX_AGE=30

# Health check intervals
HEALTH_CHECK_INTERVAL=30s
DATABASE_HEALTH_TIMEOUT=5s
REDIS_HEALTH_TIMEOUT=3s

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
# Database backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-s3-bucket
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your-s3-access-key
BACKUP_S3_SECRET_KEY=your-s3-secret-key

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# File storage (AWS S3 or compatible)
S3_BUCKET=your-production-s3-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_ENDPOINT=  # Leave empty for AWS S3, or specify for S3-compatible services

# CDN Configuration
CDN_ENABLED=true
CDN_BASE_URL=https://cdn.yourdomain.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# SaaS Features
FEATURE_MULTI_TERM_BILLING=true
FEATURE_DYNAMIC_DISCOUNTS=true
FEATURE_PLAN_UPGRADES=true
FEATURE_USAGE_ANALYTICS=true
FEATURE_WEBHOOK_NOTIFICATIONS=true

# Tenant Features
FEATURE_API_ACCESS=true
FEATURE_BULK_OPERATIONS=true
FEATURE_ADVANCED_REPORTS=true

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Server configuration
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=120s
SERVER_MAX_HEADER_BYTES=1048576

# Cache settings
CACHE_DEFAULT_TTL=1h
CACHE_PLAN_TTL=24h
CACHE_DISCOUNT_TTL=12h

# Database connection pooling
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# =============================================================================
# ALERTS & NOTIFICATIONS
# =============================================================================
# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#alerts
SLACK_USERNAME=LiquorPro-SaaS

# Email alerts
ALERT_EMAIL_ENABLED=true
ALERT_EMAIL_RECIPIENTS=admin@yourdomain.com,ops@yourdomain.com

# Alert thresholds
ALERT_ERROR_RATE_THRESHOLD=5  # percentage
ALERT_RESPONSE_TIME_THRESHOLD=1000  # milliseconds
ALERT_MEMORY_USAGE_THRESHOLD=80  # percentage

# =============================================================================
# COMPLIANCE & SECURITY
# =============================================================================
# Data retention
DATA_RETENTION_DAYS=2555  # 7 years for financial data
LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=2555

# Security headers
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_CONTENT_TYPE_NOSNIFF=true
SECURITY_FRAME_DENY=true
SECURITY_XSS_PROTECTION=true

# API Security
API_KEY_REQUIRED=true
API_RATE_LIMIT_ENABLED=true
API_REQUEST_SIZE_LIMIT=10MB

# =============================================================================
# DEPLOYMENT INFO
# =============================================================================
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_DATE=2025-09-16
DEPLOYMENT_ENVIRONMENT=production
DEPLOYMENT_COMMIT_SHA=your-git-commit-sha
DEPLOYMENT_BUILD_NUMBER=your-ci-build-number

# =============================================================================
# NOTES FOR PRODUCTION DEPLOYMENT
# =============================================================================
# 1. Replace ALL placeholder values with your actual production values
# 2. Ensure JWT_SECRET is at least 64 characters and cryptographically secure
# 3. Use strong passwords for database and Redis
# 4. Configure proper SSL certificates
# 5. Set up monitoring and alerting
# 6. Enable automatic backups
# 7. Configure proper CORS origins
# 8. Test all integrations before going live
# 9. Set up log rotation and monitoring
# 10. Configure firewalls and security groups