// AlertingMiddleware for tracking alerts in context
func AlertingMiddleware(alertManager *AlertManager) func(ctx context.Context) context.Context {
	return func(ctx context.Context) context.Context {
		return context.WithValue(ctx, "alert_manager", alertManager)
	}
}

// GetAlertManager retrieves alert manager from context
func GetAlertManager(ctx context.Context) *AlertManager {
	if am, ok := ctx.Value("alert_manager").(*AlertManager); ok {
		return am
	}
	return nil
}

// ManualAlert allows manual alert triggering
func (am *AlertManager) ManualAlert(severity AlertSeverity, rule string, message string) {
	alert := &Alert{
		ID:       fmt.Sprintf("manual-%d", time.Now().Unix()),
		Rule:     rule,
		Severity: severity,
		Annotations: map[string]string{
			"message": message,
		},
		StartsAt: time.Now(),
		Status:   AlertStatusFiring,
	}

	// Send to default channel
	if channel, exists := am.channels[am.config.DefaultChannel]; exists {
		channel.Send(alert)
	}
}